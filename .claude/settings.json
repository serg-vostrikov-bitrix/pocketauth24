{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && { [ node_modules/.package-lock.json -nt package-lock.json ] || npm install --no-audit --no-fund >&2; }",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
